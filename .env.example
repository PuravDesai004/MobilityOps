# Non-secret reference only. MobilityOps does not automatically load .env files.
# Set an override explicitly in PowerShell before launching the snapshot app:
# $env:MOBILITYOPS_SNAPSHOT_DIR = "$PWD\demo\fixture"
# Default when unset: demo/published (the verified real aggregate bundle).
MOBILITYOPS_SNAPSHOT_DIR=demo/published

# Optional local dbt interpreter override, for an isolated workspace or container:
# $env:MOBILITYOPS_DBT_PYTHON = "$PWD\.venv-dbt-local\Scripts\python.exe"
# Normal local workflows select .venv-dbt-local automatically.
# No Snowflake credentials, account values or connecting target belong here.
